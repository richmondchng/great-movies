#scalar Date

# Query type
type Query {
    movie(id: Int!): Movie
}

type Mutation {
    addMovie(movie: MovieInput!): Movie!
}

# object type
type Movie {
    id: ID!
    title: String!
    summary: String
    releaseYear: Int!
    rating: String!
    cast: [Cast!]!
    crew: [Crew!]!
}

type Cast {
    personId: ID!
    firstName: String!
    lastName: String
    sequence: Int!
    characterName: String!
}

type Crew {
    personId: ID!
    firstName: String!
    lastName: String
    sequence: Int!
    jobName: String!
}

input MovieInput {
    title: String!
    summary: String
    releaseYear: Int!
    rating: String!
}