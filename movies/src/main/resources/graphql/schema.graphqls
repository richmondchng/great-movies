#scalar Date

# Query type
type Query {
    persons(page: Int = 0, pageSize: Int = 20): Persons!
    person(id: String!): Person
    movies(page: Int = 0, pageSize: Int = 20, sortBy: String = "releaseDate", sortAsc: Boolean = true): Movies!
    movie(id: String!): Movie
}

type Mutation {
    addMovie(movie: MovieInput!): Movie!
    addPerson(person: PersonInput!): Person!
}

# object type
type Movies {
    movies: [Movie!]!
    page: Int!
    pageSize: Int!
    numberOfElements: Int!
    totalElements: Int!
    totalPages: Int!
}

type Movie {
    id: ID!
    title: String!
    summary: String
    releaseYear: Int!
    releaseDate: String!
    rating: String!
    coverImageUrl: Image,
    images: [Image!]!
    cast: [Cast!]!
    crew: [Crew!]!
}

type Image {
    id: Int!
    imageUrl: String!
    imageAlt: String
}

type Cast {
    personId: ID!
    firstName: String!
    lastName: String
    sequence: Int!
    characterName: String!
    coverImageUrl: Image
}

type Crew {
    personId: ID!
    firstName: String!
    lastName: String
    sequence: Int!
    jobName: String!
    coverImageUrl: Image
}

type Persons {
    persons: [Person!]!
    page: Int!
    pageSize: Int!
    numberOfElements: Int!
    totalElements: Int!
    totalPages: Int!
}

type Person {
    id: ID!
    firstName: String!
    lastName: String
    title: String
    coverImageUrl: Image
    workedOn: [WorkedOn!]!
    actedIn: [ActedIn!]!
}

type WorkedOn {
    jobId: String!
    jobName: String!
    movieId: String!
    movieName: String!
    releaseYear: Int!
}

type ActedIn {
    jobId: String!
    characterName: String!
    movieId: String!
    movieName: String!
    releaseYear: Int!
}

input MovieInput {
    title: String!
    summary: String
    releaseYear: Int!
    releaseDate: String!
    rating: String!
    cast: [MovieCastInput!]
    crew: [MovieCrewInput!]
}

input MovieCastInput {
    personId: String!
    characterName: String!
    sequence: Int
}

input MovieCrewInput {
    personId: String!
    jobName: String!
    sequence: Int
}

input PersonInput {
    firstName: String!
    lastName: String
    title: String
}