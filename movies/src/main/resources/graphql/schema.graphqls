#scalar Date

# Query type
type Query {
    persons(page: Int, pageSize: Int): [Person!]!
    person(id: Int!): Person
    movies(page: Int = 0, pageSize: Int = 20): Movies!
    movie(id: Int!): Movie
}

type Mutation {
    addMovie(movie: MovieInput!): Movie!
}

# object type
type Movies {
    movies: [Movie!]!
    page: Int!
    pageSize: Int!
}

type Movie {
    id: ID!
    title: String!
    summary: String
    releaseYear: Int!
    rating: String!
    cast: [Cast!]!
    crew: [Crew!]!
}

type Cast {
    personId: ID!
    firstName: String!
    lastName: String
    sequence: Int!
    characterName: String!
}

type Crew {
    personId: ID!
    firstName: String!
    lastName: String
    sequence: Int!
    jobName: String!
}

type Person {
    id: ID!
    firstName: String!
    lastName: String
    title: String
}

input MovieInput {
    title: String!
    summary: String
    releaseYear: Int!
    rating: String!
    cast: [MovieCastInput!]
    crew: [MovieCrewInput!]
}

input MovieCastInput {
    personId: Int!
    characterName: String!
    sequence: Int
}

input MovieCrewInput {
    personId: Int!
    jobName: String!
    sequence: Int
}